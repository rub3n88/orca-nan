#!/usr/bin/env python3
"""nan-usage — la suscripción de NaN (nan.builders) desde la terminal.

  nan-usage quota              cuota por modelo (usado / cap / reset)
  nan-usage usage              consumo 24h · mes · 30d · total, por modelo
  nan-usage models             modelos servidos ahora mismo + cuota + notas
  nan-usage billing            estado de la suscripción
  nan-usage ping [modelo...]   latencia real y qué modelo ha servido de verdad
  nan-usage status             una línea (para statusline / prompt)
  nan-usage config <destino>   snippet listo para pegar: env | opencode | pi | cursor | zed
  nan-usage --json <cmd>       salida JSON cruda

No es el CLI oficial de NaN (`nan`, https://nan.builders/docs/nan-cli): ese
trae la TUI y el Setup de herramientas; este da cuota por modelo, ping y status.

Key, en este orden: $NAN_API_KEY · ~/.config/nan/api-key · ~/.config/nan/env
(NAN_API_KEY=…) · ~/.config/nan/session.json del CLI oficial (campo apiKey).
La misma key sirve para la API de inferencia (api.nan.builders/v1) y para el
backend del panel (cloud-api.nan.builders), de donde salen cuotas y billing.
"""
import json
import os
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

INFERENCE = "https://api.nan.builders/v1"
CLOUD = "https://cloud-api.nan.builders"
KEY_FILE = os.path.expanduser("~/.config/nan/api-key")
ENV_FILE = os.path.expanduser("~/.config/nan/env")            # pi-fleet: NAN_API_KEY=…
SESSION_FILE = os.path.expanduser("~/.config/nan/session.json")  # CLI oficial: {"token", "apiKey"}

# Ficha por modelo. Fuente: internal/models/models.go del CLI oficial
# (helmcode/nan-cli, medido por NaN el 2026-09-11) y la doc nan.builders/docs/models
# (2026-09-16). Solo se usa para los snippets de config y las notas de `models`;
# lo vivo (qué modelos hay, cuotas) sale de la API. Si un modelo no está aquí,
# se generan valores conservadores. "max" = respuesta máxima que un cliente debe
# planificar ("Output" del CLI oficial / "Max answer" de la doc); sin él, 16K.
MODEL_NOTES = {
    "deepseek-v4-flash": {"name": "DeepSeek V4 Flash", "ctx": 1048575, "max": 32768, "input": ["text", "image"], "note": "reasoning · vision (Vision-Exp) · el recomendado para empezar"},
    "glm5.3-flash": {"name": "GLM 5.3 Flash", "ctx": 1048576, "max": 32768, "input": ["text", "image"], "note": "reasoning por defecto (verboso) · el de código sin premium"},
    "qwen3.8-flash": {"name": "Qwen 3.8 Flash", "ctx": 262144, "max": 32768, "input": ["text", "image"], "note": "reasoning por defecto · respuesta máx 131K según doc"},
    "mimo-v2.5": {"name": "Xiaomi MiMo V2.5", "ctx": 1048576, "max": 32768, "input": ["text", "image", "audio"], "note": "omnimodal · respuesta máx 131K según doc · max_tokens ≥ 300 con reasoning"},
    "gemma4": {"name": "Gemma 4", "ctx": 262144, "max": 65536, "input": ["text", "image"], "note": "multimodal"},
    "qwen3.6": {"name": "Qwen 3.6", "ctx": 262144, "max": 65536, "input": ["text", "image"], "note": "generación anterior (doc: empieza por deepseek-v4-flash)"},
    "glm5.3": {"name": "GLM 5.3 (premium)", "ctx": 1048576, "max": 32768, "input": ["text"], "note": "premium · solo texto · 3B/periodo de facturación · ventana 4h 400M"},
    "minimax-h3": {"name": "MiniMax H3", "ctx": 0, "input": ["text"], "note": "sin ficha en la doc ni en el CLI oficial: valores conservadores"},
    "qwen3-embedding": {"name": "Qwen3 Embedding", "ctx": 0, "input": ["text"], "note": "embeddings 4096d"},
    "rerank": {"name": "Rerank", "ctx": 0, "input": ["text"], "note": "reranker"},
    "whisper": {"name": "Whisper", "ctx": 0, "input": ["audio"], "note": "STT (25 MB máx)"},
    "kokoro": {"name": "Kokoro", "ctx": 0, "input": ["text"], "note": "TTS"},
    "flux-2-klein": {"name": "Flux 2 Klein", "ctx": 0, "input": ["text", "image"], "note": "imagen · 20 req/min · 100 req/mes (presupuesto aparte: no gasta cuota de tokens)"},
}
# glm5.2 (2026-09-16): ya no sale en /v1/models ni en la doc; lo sustituye glm5.3.
# Sigue apareciendo en /api/usage/quota con cap y ventana 4h: se muestra tal cual.
CHAT_EXCLUDE = {"qwen3-embedding", "rerank", "whisper", "kokoro", "flux-2-klein"}


def die(msg, code=1):
    print(f"nan-usage: {msg}", file=sys.stderr)
    sys.exit(code)


def _read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def key_from_env_file(path=None):
    path = path or ENV_FILE
    # Fichero de shell con `NAN_API_KEY=…` o `export NAN_API_KEY=…` (pi-fleet).
    for line in _read(path).splitlines():
        line = line.strip()
        if line.startswith("export "):
            line = line[7:].strip()
        if line.startswith("NAN_API_KEY="):
            return line.split("=", 1)[1].strip().strip("'\"")
    return ""


def key_from_session(path=None):
    path = path or SESSION_FILE
    # ~/.config/nan/session.json del CLI oficial (internal/session/session.go):
    # {"token": …, "apiKey": …}. Solo nos vale la apiKey; el token es de su login.
    try:
        return str(json.loads(_read(path) or "{}").get("apiKey") or "").strip()
    except (json.JSONDecodeError, AttributeError):
        return ""


def key_source():
    if os.environ.get("NAN_API_KEY", "").strip():
        return "$NAN_API_KEY"
    for path, found in ((KEY_FILE, _read(KEY_FILE).strip()), (ENV_FILE, key_from_env_file()), (SESSION_FILE, key_from_session())):
        if found:
            return path
    return "?"


def key():
    k = (os.environ.get("NAN_API_KEY", "").strip() or _read(KEY_FILE).strip()
         or key_from_env_file() or key_from_session())
    if not k:
        die(f"falta la API key: exporta NAN_API_KEY, escríbela en {KEY_FILE} (chmod 600), "
            f"o inicia sesión con el CLI oficial (`nan auth login`), que la deja en {SESSION_FILE}")
    return k


# Cloudflare devuelve 403 al User-Agent por defecto de urllib; curl y Node pasan.
def HEADERS():
    return {"Authorization": f"Bearer {key()}", "User-Agent": "nan-usage/0.2 (+https://github.com/rub3n88/orca-nan)"}


def get(base, path, timeout=20):
    req = urllib.request.Request(base + path, headers=HEADERS())
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        die(f"{path} → HTTP {e.code}")
    except urllib.error.URLError as e:
        die(f"{path} → {e.reason}")


def fmt(n):
    n = n or 0
    if n >= 1e9:
        return f"{n / 1e9:.2f}B"
    if n >= 1e6:
        return f"{n / 1e6:.1f}M"
    if n >= 1e3:
        return f"{n / 1e3:.0f}K"
    return str(int(n))


def bar(p, width=20):
    filled = int(round(p * width))
    return "█" * filled + "░" * (width - filled)


def days_left(iso_or_epoch):
    if isinstance(iso_or_epoch, (int, float)):
        end = datetime.fromtimestamp(iso_or_epoch, tz=timezone.utc)
    else:
        end = datetime.fromisoformat(iso_or_epoch.replace("Z", "+00:00"))
    return max(0, (end - datetime.now(timezone.utc)).days)


# ---------------------------------------------------------------- comandos

def cmd_quota(as_json):
    q = get(CLOUD, "/api/usage/quota")
    if as_json:
        return q
    rows = sorted(q["models"], key=lambda m: -(m["tokensUsed"] / m["cap"] if m["cap"] else 0))
    print(f"periodo desde {q.get('periodStart', '?')}")
    for m in rows:
        p = m["tokensUsed"] / m["cap"] if m["cap"] else 0
        win = f"  ventana {m['windowHours']}h: {fmt(m['fullWindowTokens'])}" if m.get("windowHours") else ""
        reset = f"reset {days_left(m['periodEnd'])}d" if m.get("periodEnd") else ""
        flag = " ⚠" if p >= 0.8 else ""
        print(f"  {m['model']:<20} {bar(p)} {p * 100:5.1f}%  {fmt(m['tokensUsed']):>7} / {fmt(m['cap']):<6} {reset}{win}{flag}")


def cmd_usage(as_json):
    u = get(CLOUD, "/api/metrics/usage")
    if as_json:
        return u
    for label, k in (("24h", "last24h"), ("mes", "monthToDate"), ("30d", "last30d"), ("total", "allTime")):
        b = u.get(k) or {}
        print(f"{label:<6} {fmt(b.get('totalTokens')):>8}")
        for m in sorted(b.get("byModel", []), key=lambda m: -(m["inputTokens"] + m["outputTokens"]))[:6]:
            print(f"         {m['model']:<24} in {fmt(m['inputTokens']):>7}  out {fmt(m['outputTokens']):>6}")
    ts = u.get("timeSeries") or []
    if ts:
        by_day = {}
        for r in ts[-14:]:
            by_day[r["date"]] = by_day.get(r["date"], 0) + r["inputTokens"] + r["outputTokens"]
        print("últimos días:", "  ".join(f"{d[5:]} {fmt(v)}" for d, v in sorted(by_day.items())[-7:]))


def cmd_models(as_json):
    live = [m["id"] for m in get(INFERENCE, "/models")["data"]]
    quota = {m["model"]: m for m in get(CLOUD, "/api/usage/quota")["models"]}
    modes = {m["name"]: m.get("mode", "") for m in get(CLOUD, "/api/agents/models").get("models", [])}
    if as_json:
        return {"models": live, "quota": quota, "modes": modes}
    print(f"{len(live)} modelos servidos ahora en {INFERENCE}")
    for mid in sorted(live):
        n = MODEL_NOTES.get(mid, {})
        q = quota.get(mid)
        cuota = f"{fmt(q['tokensUsed'])}/{fmt(q['cap'])}" if q else "—"
        ctx = ("1M ctx" if n["ctx"] >= 1_000_000 else f"{n['ctx'] // 1000}K ctx") if n.get("ctx") else ""
        tag = "" if mid in MODEL_NOTES else "  (no documentado en la ficha local)"
        print(f"  {mid:<20} {cuota:<14} {ctx:<9} {','.join(n.get('input', []))!s:<17} {n.get('note', '')}{tag}")
    print("cuotas/ctx: nan.builders/docs/models manda si esto discrepa. — no salen en /usage/quota: imagen, voz, embeddings (presupuesto aparte).")


def cmd_billing(as_json):
    b = get(CLOUD, "/api/billing")
    me = get(CLOUD, "/api/auth/me")
    if as_json:
        return {"billing": b, "me": me}
    s = b.get("subscription") or {}
    start = datetime.fromtimestamp(s.get("currentPeriodStart", 0), tz=timezone.utc).date()
    end = datetime.fromtimestamp(s.get("currentPeriodEnd", 0), tz=timezone.utc).date()
    print(f"{me.get('handle')} · tier {me.get('tier')} · región {me.get('region')} · namespace {me.get('namespace')}")
    print(f"suscripción {s.get('status')} · {str(s.get('currency', '')).upper()} · premium (glm5.3): {'sí' if s.get('premium') else 'no'}")
    print(f"periodo {start} → {end} ({days_left(s.get('currentPeriodEnd', 0))} días)")
    if s.get("cancelAtPeriodEnd"):
        print("⚠ cancelación programada al final del periodo")
    print("features:", ", ".join(k for k, v in (me.get("features") or {}).items() if v) or "—")


def ping_one(model):
    body = {"model": model, "messages": [{"role": "user", "content": "ping"}], "max_tokens": 8, "stream": True}
    req = urllib.request.Request(
        INFERENCE + "/chat/completions",
        data=json.dumps(body).encode(),
        headers={**HEADERS(), "Content-Type": "application/json"},
    )
    t0 = time.time()
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            served = None
            for raw in r:
                line = raw.decode(errors="ignore").strip()
                if not line.startswith("data:") or line.endswith("[DONE]"):
                    continue
                try:
                    served = json.loads(line[5:]).get("model")
                except json.JSONDecodeError:
                    continue
                if served:
                    break
            ttft = time.time() - t0
            return {"model": model, "ok": True, "ttft_s": round(ttft, 2), "served": served}
    except urllib.error.HTTPError as e:
        return {"model": model, "ok": False, "ttft_s": round(time.time() - t0, 2), "error": f"HTTP {e.code}"}
    except Exception as e:  # timeout, reset…
        return {"model": model, "ok": False, "ttft_s": round(time.time() - t0, 2), "error": str(e)[:60]}


def cmd_ping(as_json, args):
    models = args or [m["id"] for m in get(INFERENCE, "/models")["data"] if m["id"] not in CHAT_EXCLUDE]
    out = []
    for m in models:
        r = ping_one(m)
        out.append(r)
        if not as_json:
            if r["ok"]:
                swap = "" if r["served"] in (None, m) else f"  ⚠ sirvió {r['served']} (fallback silencioso)"
                print(f"  {m:<20} ok   {r['ttft_s']:>5.2f}s primer token{swap}")
            else:
                print(f"  {m:<20} FAIL {r['ttft_s']:>5.2f}s  {r['error']}")
    return out if as_json else None


def cmd_status(as_json):
    q = get(CLOUD, "/api/usage/quota")
    used = [m for m in q["models"] if m["tokensUsed"] > 0]
    if as_json:
        return q
    parts = []
    for m in sorted(used, key=lambda m: -(m["tokensUsed"] / m["cap"] if m["cap"] else 0)):
        p = m["tokensUsed"] / m["cap"] * 100 if m["cap"] else 0
        short = m["model"].replace("deepseek-v4-flash", "ds4f").replace("-flash", "f")
        parts.append(f"{short} {p:.0f}%{'⚠' if p >= 80 else ''}")
    reset = next((m["periodEnd"] for m in q["models"] if m.get("periodEnd") and not m.get("windowHours")), None)
    tail = f" | {days_left(reset)}d" if reset else ""
    print("NaN " + (" · ".join(parts) if parts else "0%") + tail)


def chat_models():
    live = [m["id"] for m in get(INFERENCE, "/models")["data"]]
    return [m for m in sorted(live) if m not in CHAT_EXCLUDE]


OFFICIAL_SETUP = ("# El CLI oficial de NaN (`nan` → pestaña Setup) configura OpenCode, Codex, Pi, droid y "
                  "Hermes por sí solo; estos snippets son para el resto o para revisar a mano.")
PI_WARNING = """# ⚠ Si usas @gtrabanco/pi-nan-provider (pi-fleet), NO pegues este bloque ni uses el Setup del
# CLI oficial: el bloque `providers.nan` lo genera la extensión/pi-fleet con los `compat` que
# necesita (supportsReasoningEffort, supportsFinishReason, maxTokensField) y el Setup oficial
# reemplaza `providers.nan` entero y los pisa. Este snippet es para pi *sin* esa extensión."""


def cmd_config(as_json, args):
    target = (args or ["help"])[0]
    if target not in ("env", "opencode", "pi", "cursor", "zed"):
        print("destinos: env | opencode | pi | cursor | zed\n(Claude Code no: NaN es OpenAI-compatible, no habla el protocolo Anthropic)")
        print(OFFICIAL_SETUP)
        return
    k = key()
    masked = k[:6] + "…" + k[-4:]
    src = key_source()
    print(OFFICIAL_SETUP)
    if target == "env":
        print(f'export OPENAI_BASE_URL="{INFERENCE}"')
        if src == "$NAN_API_KEY":
            print('export OPENAI_API_KEY="$NAN_API_KEY"')
        elif src == KEY_FILE:
            print(f'export OPENAI_API_KEY="$(cat {KEY_FILE})"   # {masked}')
        else:
            print(f'export OPENAI_API_KEY="{masked}"   # pega la key entera (origen: {src})')
        print("# Cline / Continue / Aider / cualquier SDK OpenAI-compatible")
        return
    if target == "cursor":
        print(f"Cursor → Settings → Models → OpenAI API:\n  Base URL: {INFERENCE}\n  API Key:  {masked}  (origen: {src})")
        print("  Modelos a añadir a mano:", ", ".join(chat_models()))
        return
    models = chat_models()
    if target == "opencode":
        cfg = {
            "$schema": "https://opencode.ai/config.json",
            "provider": {"nan": {
                "npm": "@ai-sdk/openai-compatible", "name": "NaN",
                "options": {"baseURL": INFERENCE, "apiKey": "{env:NAN_API_KEY}"},
                "models": {m: {
                    "name": MODEL_NOTES.get(m, {}).get("name", m),
                    "contextWindow": MODEL_NOTES.get(m, {}).get("ctx") or 131072,
                    "modalities": {"input": MODEL_NOTES.get(m, {}).get("input", ["text"]), "output": ["text"]},
                } for m in models},
            }},
            "compaction": {"auto": True, "prune": True, "reserved": 50000},
        }
        print("# ~/.config/opencode/opencode.json — exporta NAN_API_KEY o sustituye {env:NAN_API_KEY}")
        print(json.dumps(cfg, indent=2, ensure_ascii=False))
        return
    if target == "pi":
        models_json = {"providers": {"nan": {
            "baseUrl": INFERENCE, "apiKey": k, "api": "openai-completions",
            "models": [{
                "id": m, "name": MODEL_NOTES.get(m, {}).get("name", m), "reasoning": True,
                "input": MODEL_NOTES.get(m, {}).get("input", ["text"]),
                "contextWindow": MODEL_NOTES.get(m, {}).get("ctx") or 131072,
                "maxTokens": MODEL_NOTES.get(m, {}).get("max") or 16384,
            } for m in models],
        }}}
        print(PI_WARNING)
        print("# ~/.pi/agent/models.json  (lleva la key en claro: chmod 600)")
        print(json.dumps(models_json, indent=2, ensure_ascii=False))
        print("\n# ~/.pi/agent/settings.json")
        print(json.dumps({"defaultProvider": "nan", "defaultModel": models[0]}, indent=2))
        return
    if target == "zed":
        cfg = {"language_models": {"openai": {"api_url": INFERENCE, "available_models": [
            {"name": m, "display_name": f"NaN {m}", "max_tokens": MODEL_NOTES.get(m, {}).get("ctx") or 131072} for m in models]}}}
        print("# ~/.config/zed/settings.json (la key va en el asistente de Zed, no aquí)")
        print(json.dumps(cfg, indent=2))
        return


def main(argv):
    as_json = "--json" in argv
    argv = [a for a in argv if a != "--json"]
    cmd, args = (argv[0] if argv else "quota"), argv[1:]
    table = {
        "quota": lambda: cmd_quota(as_json), "usage": lambda: cmd_usage(as_json),
        "models": lambda: cmd_models(as_json), "billing": lambda: cmd_billing(as_json),
        "ping": lambda: cmd_ping(as_json, args), "status": lambda: cmd_status(as_json),
        "config": lambda: cmd_config(as_json, args),
    }
    if cmd in ("-h", "--help", "help") or cmd not in table:
        print(__doc__.strip())
        return 0 if cmd in ("-h", "--help", "help") else 2
    result = table[cmd]()
    if as_json and result is not None:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
